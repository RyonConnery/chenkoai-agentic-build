# App
CHENKOAI_ENV=development
CHENKOAI_APP_NAME=chenkoai-agentic-build
CHENKOAI_API_PORT=8787

# Database
DATABASE_URL=postgresql://chenkoai:chenkoai_dev_password@localhost:5432/chenkoai
VECTOR_DATABASE_URL=http://localhost:6333

# LLM Providers
MODEL_PROVIDER=mock
EMBEDDING_PROVIDER=mock
MOCK_EMBEDDING_DIMENSIONS=64
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.1
LOCAL_EMBEDDING_MODEL=nomic-embed-text

# Agent Runtime
AGENT_MAX_STEPS=12
AGENT_ENABLE_LOCAL_TOOLS=false
AGENT_MEMORY_NAMESPACE=chenkoai-dev
AGENT_RUN_STORE=memory
PROMPT_REGISTRY_STORE=memory
DATA_STORE=memory
